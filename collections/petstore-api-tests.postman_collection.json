  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level checks applied to every request",
          "const maxMs = Number(pm.environment.get(\"maxResponseTimeMs\") || 3000);",
          "pm.test(`Response time is below ${maxMs}ms`, () => pm.expect(pm.response.responseTime).to.be.below(maxMs));"
