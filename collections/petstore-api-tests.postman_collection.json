      "name": "01 - Store",
      "item": [
        {
          "name": "Get store inventory",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Inventory is a map of status -> count\", () => {",
                  "    const inv = pm.response.json();",
                  "    pm.expect(inv).to.be.an(\"object\");",
                  "    Object.values(inv).forEach(count => pm.expect(count).to.be.a(\"number\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/inventory",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "inventory"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Pet lifecycle",
      "description": "Create -> read -> update -> verify -> search -> delete -> verify gone. Requests depend on each other and must run in order.",
      "item": [
        {
          "name": "Create pet",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique id per run/iteration so parallel or repeated runs never collide.",
                  "// Values come from the CSV data file when one is supplied (newman -d).",
                  "const petId = Date.now() * 1000 + Math.floor(Math.random() * 1000);",
                  "pm.collectionVariables.set(\"petId\", petId);",
                  "pm.collectionVariables.set(\"petName\", pm.iterationData.get(\"name\") || `pet-${petId}`);",
                  "pm.collectionVariables.set(\"petCategory\", pm.iterationData.get(\"category\") || \"Dogs\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const petSchema = {",
                  "    type: \"object\",",
                  "    required: [\"id\", \"name\", \"photoUrls\", \"status\"],",
                  "    properties: {",
                  "        id: { type: \"integer\" },",
                  "        name: { type: \"string\" },",
                  "        photoUrls: { type: \"array\", items: { type: \"string\" } },",
                  "        status: { type: \"string\", enum: [\"available\", \"pending\", \"sold\"] },",
                  "        category: {",
                  "            type: \"object\",",
                  "            properties: { id: { type: \"integer\" }, name: { type: \"string\" } }",
                  "        },",
                  "        tags: { type: \"array\" }",
                  "    }",
                  "};",
                  "",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body matches the Pet schema\", () => pm.response.to.have.jsonSchema(petSchema));",
                  "",
                  "const pet = pm.response.json();",
                  "pm.test(\"Echoes the submitted id, name and status\", () => {",
                  "    pm.expect(pet.id).to.eql(Number(pm.collectionVariables.get(\"petId\")));",
                  "    pm.expect(pet.name).to.eql(pm.collectionVariables.get(\"petName\"));",
                  "    pm.expect(pet.status).to.eql(\"available\");",
                  "});",
                  "pm.test(\"Category is stored\", () => pm.expect(pet.category.name).to.eql(pm.collectionVariables.get(\"petCategory\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{petId}},\n  \"category\": { \"id\": 1, \"name\": \"{{petCategory}}\" },\n  \"name\": \"{{petName}}\",\n  \"photoUrls\": [\"https://example.com/{{petName}}.jpg\"],\n  \"tags\": [{ \"id\": 1, \"name\": \"qa-portfolio\" }],\n  \"status\": \"available\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get pet by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const petSchema = {",
                  "    type: \"object\",",
                  "    required: [\"id\", \"name\", \"photoUrls\", \"status\"],",
                  "    properties: {",
                  "        id: { type: \"integer\" },",
                  "        name: { type: \"string\" },",
                  "        photoUrls: { type: \"array\", items: { type: \"string\" } },",
                  "        status: { type: \"string\", enum: [\"available\", \"pending\", \"sold\"] },",
                  "        category: {",
                  "            type: \"object\",",
                  "            properties: { id: { type: \"integer\" }, name: { type: \"string\" } }",
                  "        },",
                  "        tags: { type: \"array\" }",
                  "    }",
                  "};",
                  "",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body matches the Pet schema\", () => pm.response.to.have.jsonSchema(petSchema));",
                  "pm.test(\"Returns the pet that was created\", () => {",
                  "    const pet = pm.response.json();",
                  "    pm.expect(pet.id).to.eql(Number(pm.collectionVariables.get(\"petId\")));",
                  "    pm.expect(pet.name).to.eql(pm.collectionVariables.get(\"petName\"));",
                  "});",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pet/{{petId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
                "{{petId}}"
              ]
            }
          }
        },
